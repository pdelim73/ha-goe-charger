{
  "config": {
    "step": {
      "user": {
        "title": "Connect to your go-e Charger Gemini",
        "description": "Enter the local IP address or hostname of your charger. This integration only ever reads its status - it never changes any setting - so it is safe to add alongside evcc or the go-e app.",
        "data": {
          "host": "Host or IP address",
          "name": "Name (optional)"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the charger at that address. Check the IP and that the go-e app's HTTP API is enabled."
    },
    "abort": {
      "already_configured": "This charger is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "go-e Charger Gemini options",
        "data": {
          "scan_interval": "Poll interval (seconds)"
        },
        "data_description": {
          "scan_interval": "How often to read the charger's status. Kept at 15s or slower by default to stay a light, non-intrusive second reader alongside evcc."
        }
      }
    }
  },
